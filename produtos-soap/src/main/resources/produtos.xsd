<?xml version="1.0" encoding="UTF-8"?>

<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    targetNamespace="http://cps.sp.gov.br/produtos"
    xmlns:tns="http://cps.sp.gov.br/produtos"
    elementFormDefault="qualified">

    <!-- REQUISIÇÃO -->
    <xs:element name="consultarProdutoRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="codigo" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- RESPOSTA -->
    <xs:element name="consultarProdutoResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="nome" type="xs:string"/>
                <xs:element name="descricao" type="xs:string"/>
                <xs:element name="marca" type="xs:string"/>
                <xs:element name="quantidadeEstoque" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- FAULT: detalhe enviado dentro do <detail> do SOAP Fault.
         O sufixo "Fault" faz o DefaultWsdl11Definition publicar
         este elemento como wsdl:fault da operação consultarProduto. -->
    <xs:element name="consultarProdutoFault">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="codigo" type="xs:string"/>
                <xs:element name="mensagem" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
